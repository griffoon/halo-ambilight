<?xml version="1.0" encoding="utf-8" ?>
<local:HaloPage
    x:Class="HaloSettings.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:HaloSettings.Controls"
    xmlns:local="using:HaloSettings.Pages"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Style="{StaticResource PageContentStyle}">
            <TextBlock Style="{StaticResource PageTitleStyle}" Text="Главная" />

            <!-- Live preview and connection state -->
            <Border
                Padding="16,8,16,16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="2">
                    <controls:LedPreview x:Name="Preview" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind ViewModel.DeviceTitle, Mode=OneWay}" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind ViewModel.DeviceDetail, Mode=OneWay}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <InfoBar
                Margin="0,8,0,0"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.OfflineOpen, Mode=OneWay}"
                Message="Без неё лента не получает цвета."
                Severity="Error"
                Title="Служба Halo не запущена">
                <InfoBar.ActionButton>
                    <Button Command="{x:Bind ViewModel.StartServiceCommand}" Content="Запустить" />
                </InfoBar.ActionButton>
            </InfoBar>
            <InfoBar
                Margin="0,8,0,0"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.ProblemOpen, Mode=OneWay}"
                Message="{x:Bind ViewModel.Problem, Mode=OneWay}"
                Severity="Warning" />

            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Свет" />
            <StackPanel controls:CardGroup.IsGroup="True">
                <toolkit:SettingsCard Description="{x:Bind ViewModel.ModeHint, Mode=OneWay}" Header="Подсветка">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE7E8;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <ToggleSwitch IsOn="{x:Bind ViewModel.Enabled, Mode=TwoWay}" />
                </toolkit:SettingsCard>
                <toolkit:SettingsCard Header="Яркость">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE706;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <controls:DefaultSlider
                        DefaultValue="60"
                        Maximum="100"
                        Minimum="0"
                        Value="{x:Bind ViewModel.Brightness, Mode=TwoWay}" />
                </toolkit:SettingsCard>
            </StackPanel>

            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Режим" />
            <SelectorBar x:Name="ModeBar" Margin="-4,0,0,8" SelectionChanged="OnModeSelected">
                <SelectorBarItem Text="Экран" />
                <SelectorBarItem Text="Цвет" />
                <SelectorBarItem Text="Дыхание" />
                <SelectorBarItem Text="Радуга" />
                <SelectorBarItem Text="Аврора" />
            </SelectorBar>
            <StackPanel controls:CardGroup.IsGroup="True">
                <toolkit:SettingsCard
                    Click="OnModeSettingsClick"
                    Description="{x:Bind ViewModel.ModeHint, Mode=OneWay}"
                    Header="Настройки режима"
                    IsClickEnabled="True">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE9E9;" />
                    </toolkit:SettingsCard.HeaderIcon>
                </toolkit:SettingsCard>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</local:HaloPage>

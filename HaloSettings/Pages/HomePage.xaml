<?xml version="1.0" encoding="utf-8" ?>
<local:HaloPage
    x:Class="HaloSettings.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:HaloSettings.Controls"
    xmlns:local="using:HaloSettings.Pages"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">

    <Page.Resources>
        <!-- In-block group header, as on the Settings home page -->
        <Style x:Key="GroupHeaderStyle" TargetType="Border">
            <Setter Property="Padding" Value="20,18,20,16" />
        </Style>
        <Style x:Key="TileIconStyle" TargetType="FontIcon">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,2,12,0" />
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="12" Style="{StaticResource PageContentStyle}">
            <TextBlock Style="{StaticResource PageTitleStyle}" Text="Главная" />

            <!-- Header: live thumbnail with the strip's glow, the strip's name, status tiles -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Viewbox Width="208" Height="134" Stretch="Uniform">
                    <controls:LedPreview x:Name="Preview" Width="420" Height="270" />
                </Viewbox>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="{x:Bind ViewModel.DeviceTitle, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="{x:Bind ViewModel.DeviceDetail, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <HyperlinkButton
                        Margin="-11,2,0,0"
                        Command="{x:Bind ViewModel.RescanCommand}"
                        Content="Найти заново" />
                </StackPanel>
            </Grid>

            <Grid Margin="0,4,0,4" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <FontIcon Glyph="&#xE706;" Style="{StaticResource TileIconStyle}" />
                    <StackPanel>
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Подсветка" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.PowerSummary, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <FontIcon Glyph="&#xE7F4;" Style="{StaticResource TileIconStyle}" />
                    <StackPanel>
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Режим" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.ModeName, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.OfflineOpen, Mode=OneWay}"
                Message="Без неё лента не получает цвета."
                Severity="Error"
                Title="Служба Halo не запущена">
                <InfoBar.ActionButton>
                    <Button Command="{x:Bind ViewModel.StartServiceCommand}" Content="Запустить" />
                </InfoBar.ActionButton>
            </InfoBar>
            <InfoBar
                IsOpen="{x:Bind ViewModel.UpdateOpen, Mode=TwoWay}"
                Message="Новый релиз Halo уже на GitHub."
                Severity="Informational"
                Title="{x:Bind ViewModel.UpdateTitle, Mode=OneWay}">
                <InfoBar.ActionButton>
                    <Button Command="{x:Bind ViewModel.DownloadUpdateCommand}" Content="Скачать" />
                </InfoBar.ActionButton>
            </InfoBar>
            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.ProblemOpen, Mode=OneWay}"
                Message="{x:Bind ViewModel.Problem, Mode=OneWay}"
                Severity="Warning" />

            <StackPanel controls:CardGroup.IsGroup="True">
                <Border Style="{StaticResource GroupHeaderStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Свет" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="Включение и яркость подсветки" />
                    </StackPanel>
                </Border>
                <toolkit:SettingsCard Description="{x:Bind ViewModel.ModeHint, Mode=OneWay}" Header="Подсветка">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE7E8;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <ToggleSwitch IsOn="{x:Bind ViewModel.Enabled, Mode=TwoWay}" />
                </toolkit:SettingsCard>
                <toolkit:SettingsCard Header="Яркость">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE706;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <controls:DefaultSlider
                        DefaultValue="60"
                        Maximum="100"
                        Minimum="0"
                        Value="{x:Bind ViewModel.Brightness, Mode=TwoWay}" />
                </toolkit:SettingsCard>
            </StackPanel>

            <!-- Same pattern as "Choose where to play sound" in Settings: an expander of radio rows -->
            <toolkit:SettingsExpander
                Description="Как лента выбирает цвета"
                Header="Режим подсветки"
                IsExpanded="True">
                <toolkit:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE7F4;" />
                </toolkit:SettingsExpander.HeaderIcon>
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.ModeName, Mode=OneWay}" />
                <toolkit:SettingsExpander.Items>
                    <toolkit:SettingsCard ContentAlignment="Left">
                        <RadioButton
                            x:Name="Mode0"
                            Checked="OnModeChecked"
                            GroupName="Mode"
                            Tag="0">
                            <StackPanel>
                                <TextBlock Text="Экран" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="Лента повторяет края экрана" />
                            </StackPanel>
                        </RadioButton>
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard ContentAlignment="Left">
                        <RadioButton
                            x:Name="Mode1"
                            Checked="OnModeChecked"
                            GroupName="Mode"
                            Tag="1">
                            <StackPanel>
                                <TextBlock Text="Цвет" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="Один ровный цвет" />
                            </StackPanel>
                        </RadioButton>
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard ContentAlignment="Left">
                        <RadioButton
                            x:Name="Mode2"
                            Checked="OnModeChecked"
                            GroupName="Mode"
                            Tag="2">
                            <StackPanel>
                                <TextBlock Text="Дыхание" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="Цвет плавно дышит" />
                            </StackPanel>
                        </RadioButton>
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard ContentAlignment="Left">
                        <RadioButton
                            x:Name="Mode3"
                            Checked="OnModeChecked"
                            GroupName="Mode"
                            Tag="3">
                            <StackPanel>
                                <TextBlock Text="Радуга" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="Радуга бежит по кругу" />
                            </StackPanel>
                        </RadioButton>
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard ContentAlignment="Left">
                        <RadioButton
                            x:Name="Mode4"
                            Checked="OnModeChecked"
                            GroupName="Mode"
                            Tag="4">
                            <StackPanel>
                                <TextBlock Text="Аврора" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="Медленные переливы бирюзы и фиолета" />
                            </StackPanel>
                        </RadioButton>
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard
                        Click="OnModeSettingsClick"
                        Header="Настройки режима"
                        IsClickEnabled="True" />
                </toolkit:SettingsExpander.Items>
            </toolkit:SettingsExpander>
        </StackPanel>
    </ScrollViewer>
</local:HaloPage>

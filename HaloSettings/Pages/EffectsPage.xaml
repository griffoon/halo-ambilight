<?xml version="1.0" encoding="utf-8" ?>
<local:HaloPage
    x:Class="HaloSettings.Pages.EffectsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:HaloSettings.Controls"
    xmlns:local="using:HaloSettings.Pages"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Style="{StaticResource PageContentStyle}">
            <TextBlock Style="{StaticResource PageTitleStyle}" Text="Цвет и эффекты" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource BodyTextBlockStyle}"
                Text="Для режимов «Цвет», «Дыхание», «Радуга» и «Аврора»."
                TextWrapping="Wrap" />

            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Цвет" />
            <StackPanel controls:CardGroup.IsGroup="True">
                <toolkit:SettingsCard
                    ContentAlignment="Vertical"
                    Description="Для режимов «Цвет» и «Дыхание»"
                    Header="Оттенок">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE790;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <StackPanel x:Name="Swatches" Orientation="Horizontal" Spacing="8" />
                </toolkit:SettingsCard>
            </StackPanel>

            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Движение" />
            <StackPanel controls:CardGroup.IsGroup="True">
                <toolkit:SettingsCard Description="Для режимов «Дыхание», «Радуга» и «Аврора»" Header="Скорость">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE916;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <controls:DefaultSlider
                        DefaultValue="1"
                        Maximum="4"
                        Minimum="0.1"
                        StepFrequency="0.1"
                        Value="{x:Bind ViewModel.Speed, Mode=TwoWay}" />
                </toolkit:SettingsCard>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</local:HaloPage>

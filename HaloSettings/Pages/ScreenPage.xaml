<?xml version="1.0" encoding="utf-8" ?>
<local:HaloPage
    x:Class="HaloSettings.Pages.ScreenPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:HaloSettings.Controls"
    xmlns:local="using:HaloSettings.Pages"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Style="{StaticResource PageContentStyle}">
            <TextBlock Style="{StaticResource PageTitleStyle}" Text="Экран" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource BodyTextBlockStyle}"
                Text="Настройки режима «Экран»: лента повторяет то, что у краёв картинки."
                TextWrapping="Wrap" />

            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Источник" />
            <StackPanel controls:CardGroup.IsGroup="True">
                <toolkit:SettingsCard Header="Монитор">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE7F4;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <ComboBox
                        MinWidth="200"
                        ItemsSource="{x:Bind ViewModel.Monitors, Mode=OneTime}"
                        SelectedIndex="{x:Bind ViewModel.MonitorIndex, Mode=TwoWay}" />
                </toolkit:SettingsCard>
                <toolkit:SettingsCard Header="Частота обновления">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE916;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <ComboBox MinWidth="200" SelectedIndex="{x:Bind ViewModel.FpsIndex, Mode=TwoWay}">
                        <x:String>30 кадров в секунду</x:String>
                        <x:String>60 кадров в секунду</x:String>
                    </ComboBox>
                </toolkit:SettingsCard>
            </StackPanel>

            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Картинка" />
            <StackPanel controls:CardGroup.IsGroup="True">
                <toolkit:SettingsCard Description="Насколько мягко цвет догоняет картинку" Header="Плавность">
                    <controls:DefaultSlider
                        DefaultValue="45"
                        Maximum="100"
                        Minimum="0"
                        Value="{x:Bind ViewModel.Smoothing, Mode=TwoWay}" />
                </toolkit:SettingsCard>
                <toolkit:SettingsCard Header="Насыщенность">
                    <controls:DefaultSlider
                        DefaultValue="115"
                        Maximum="200"
                        Minimum="0"
                        Value="{x:Bind ViewModel.Saturation, Mode=TwoWay}" />
                </toolkit:SettingsCard>
                <toolkit:SettingsCard Description="Какую полосу у края экрана видит каждый диод" Header="Глубина захвата">
                    <controls:DefaultSlider
                        DefaultValue="12"
                        Maximum="45"
                        Minimum="3"
                        Value="{x:Bind ViewModel.Depth, Mode=TwoWay}" />
                </toolkit:SettingsCard>
                <toolkit:SettingsCard Description="Подсветка не гаснет на фильмах с полосами" Header="Убирать чёрные полосы">
                    <ToggleSwitch IsOn="{x:Bind ViewModel.Letterbox, Mode=TwoWay}" />
                </toolkit:SettingsCard>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</local:HaloPage>

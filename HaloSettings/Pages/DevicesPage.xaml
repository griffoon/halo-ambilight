<?xml version="1.0" encoding="utf-8" ?>
<local:HaloPage
    x:Class="HaloSettings.Pages.DevicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:HaloSettings.Controls"
    xmlns:local="using:HaloSettings.Pages"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Style="{StaticResource PageContentStyle}">
            <TextBlock Style="{StaticResource PageTitleStyle}" Text="Клавиатура и RGB" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource BodyTextBlockStyle}"
                Text="Halo может красить клавиатуру, материнскую плату и другую подсветку средним цветом ленты через OpenRGB. Меняются только отмеченные устройства, остальные остаются как есть."
                TextWrapping="Wrap" />

            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="OpenRGB" />
            <StackPanel controls:CardGroup.IsGroup="True">
                <toolkit:SettingsCard Description="Нужен запущенный OpenRGB с включённым SDK-сервером" Header="Синхронизировать через OpenRGB">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE765;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <ToggleSwitch IsOn="{x:Bind ViewModel.OpenRgbEnabled, Mode=TwoWay}" />
                </toolkit:SettingsCard>
            </StackPanel>

            <InfoBar
                Margin="0,8,0,0"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.OpenRgbNoteOpen, Mode=OneWay}"
                Message="{x:Bind ViewModel.OpenRgbNote, Mode=OneWay}"
                Severity="Warning" />

            <TextBlock x:Name="DevicesHeader" Style="{StaticResource SectionHeaderStyle}" Text="Устройства" />
            <StackPanel x:Name="DeviceList" />
        </StackPanel>
    </ScrollViewer>
</local:HaloPage>

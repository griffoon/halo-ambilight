<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="HaloSettings.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:HaloSettings.Controls"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:vm="using:HaloSettings.ViewModels"
    Background="Transparent">

    <Page.Resources>
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
            <Setter Property="Margin" Value="1,28,0,6" />
        </Style>
        <Style x:Key="CardSliderStyle" TargetType="Slider" BasedOn="{StaticResource DefaultSliderStyle}">
            <Setter Property="Width" Value="190" />
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="680" Padding="20,4,20,28" Spacing="4">

            <!-- Live preview and connection state -->
            <Border
                Padding="16,12,16,16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource OverlayCornerRadius}">
                <StackPanel Spacing="4">
                    <controls:LedPreview x:Name="Preview" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind ViewModel.DeviceTitle, Mode=OneWay}" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind ViewModel.DeviceDetail, Mode=OneWay}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <InfoBar
                Margin="0,4,0,0"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.OfflineOpen, Mode=OneWay}"
                Message="Без неё лента не получает цвета."
                Severity="Error"
                Title="Служба Halo не запущена">
                <InfoBar.ActionButton>
                    <Button Command="{x:Bind ViewModel.StartServiceCommand}" Content="Запустить" />
                </InfoBar.ActionButton>
            </InfoBar>
            <InfoBar
                Margin="0,4,0,0"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.ProblemOpen, Mode=OneWay}"
                Message="{x:Bind ViewModel.Problem, Mode=OneWay}"
                Severity="Warning" />

            <!-- Light -->
            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Свет" />
            <toolkit:SettingsCard Description="{x:Bind ViewModel.ModeHint, Mode=OneWay}" Header="Подсветка">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE7E8;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ToggleSwitch IsOn="{x:Bind ViewModel.Enabled, Mode=TwoWay}" />
            </toolkit:SettingsCard>
            <toolkit:SettingsCard Header="Яркость">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE706;" />
                </toolkit:SettingsCard.HeaderIcon>
                <Slider
                    Maximum="100"
                    Minimum="0"
                    Style="{StaticResource CardSliderStyle}"
                    Value="{x:Bind ViewModel.Brightness, Mode=TwoWay}" />
            </toolkit:SettingsCard>

            <!-- Mode -->
            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Режим" />
            <SelectorBar x:Name="ModeBar" Margin="-4,0,0,4" SelectionChanged="OnModeSelected">
                <SelectorBarItem Text="Экран" />
                <SelectorBarItem Text="Цвет" />
                <SelectorBarItem Text="Дыхание" />
                <SelectorBarItem Text="Радуга" />
                <SelectorBarItem Text="Аврора" />
            </SelectorBar>

            <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.IsScreen, Mode=OneWay}">
                <toolkit:SettingsCard Header="Монитор">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE7F4;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <ComboBox
                        MinWidth="190"
                        ItemsSource="{x:Bind ViewModel.Monitors, Mode=OneTime}"
                        SelectedIndex="{x:Bind ViewModel.MonitorIndex, Mode=TwoWay}" />
                </toolkit:SettingsCard>
                <toolkit:SettingsCard Description="Насколько мягко цвет догоняет картинку" Header="Плавность">
                    <Slider
                        Maximum="100"
                        Minimum="0"
                        Style="{StaticResource CardSliderStyle}"
                        Value="{x:Bind ViewModel.Smoothing, Mode=TwoWay}" />
                </toolkit:SettingsCard>
                <toolkit:SettingsCard Header="Насыщенность">
                    <Slider
                        Maximum="200"
                        Minimum="0"
                        Style="{StaticResource CardSliderStyle}"
                        Value="{x:Bind ViewModel.Saturation, Mode=TwoWay}" />
                </toolkit:SettingsCard>
                <toolkit:SettingsCard Description="Какую полосу у края экрана видит каждый диод" Header="Глубина захвата">
                    <Slider
                        Maximum="45"
                        Minimum="3"
                        Style="{StaticResource CardSliderStyle}"
                        Value="{x:Bind ViewModel.Depth, Mode=TwoWay}" />
                </toolkit:SettingsCard>
                <toolkit:SettingsCard Header="Частота обновления">
                    <ComboBox MinWidth="190" SelectedIndex="{x:Bind ViewModel.FpsIndex, Mode=TwoWay}">
                        <x:String>30 кадров в секунду</x:String>
                        <x:String>60 кадров в секунду</x:String>
                    </ComboBox>
                </toolkit:SettingsCard>
                <toolkit:SettingsCard Description="Подсветка не гаснет на фильмах с полосами" Header="Убирать чёрные полосы">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE740;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <ToggleSwitch IsOn="{x:Bind ViewModel.Letterbox, Mode=TwoWay}" />
                </toolkit:SettingsCard>
            </StackPanel>

            <toolkit:SettingsCard
                ContentAlignment="Vertical"
                Header="Цвет"
                Visibility="{x:Bind ViewModel.IsColor, Mode=OneWay}">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE790;" />
                </toolkit:SettingsCard.HeaderIcon>
                <StackPanel x:Name="Swatches" Orientation="Horizontal" Spacing="8" />
            </toolkit:SettingsCard>

            <toolkit:SettingsCard Header="Скорость" Visibility="{x:Bind ViewModel.HasSpeed, Mode=OneWay}">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE916;" />
                </toolkit:SettingsCard.HeaderIcon>
                <Slider
                    Maximum="4"
                    Minimum="0.1"
                    StepFrequency="0.1"
                    Style="{StaticResource CardSliderStyle}"
                    Value="{x:Bind ViewModel.Speed, Mode=TwoWay}" />
            </toolkit:SettingsCard>

            <!-- Strip -->
            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Лента" />
            <toolkit:SettingsExpander Description="{x:Bind ViewModel.LedCount, Mode=OneWay}" Header="Разметка">
                <toolkit:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE81E;" />
                </toolkit:SettingsExpander.HeaderIcon>
                <toolkit:SettingsExpander.Items>
                    <toolkit:SettingsCard Header="Слева, снизу вверх">
                        <NumberBox Maximum="300" Minimum="0" SpinButtonPlacementMode="Inline" Value="{x:Bind ViewModel.Left, Mode=TwoWay}" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard Header="Сверху, слева направо">
                        <NumberBox Maximum="300" Minimum="0" SpinButtonPlacementMode="Inline" Value="{x:Bind ViewModel.Top, Mode=TwoWay}" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard Header="Справа, сверху вниз">
                        <NumberBox Maximum="300" Minimum="0" SpinButtonPlacementMode="Inline" Value="{x:Bind ViewModel.Right, Mode=TwoWay}" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard Header="Снизу, справа налево">
                        <NumberBox Maximum="300" Minimum="0" SpinButtonPlacementMode="Inline" Value="{x:Bind ViewModel.Bottom, Mode=TwoWay}" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard Description="Если лента начинается справа снизу" Header="Обратное направление">
                        <ToggleSwitch IsOn="{x:Bind ViewModel.Reverse, Mode=TwoWay}" />
                    </toolkit:SettingsCard>
                </toolkit:SettingsExpander.Items>
            </toolkit:SettingsExpander>
            <toolkit:SettingsCard
                Command="{x:Bind ViewModel.RescanCommand}"
                Description="Если ленту переподключили в другой порт"
                Header="Найти ленту заново"
                IsClickEnabled="True">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE895;" />
                </toolkit:SettingsCard.HeaderIcon>
            </toolkit:SettingsCard>

            <!-- System -->
            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Система" />
            <toolkit:SettingsCard Header="Запускать вместе с Windows">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE713;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ToggleSwitch IsOn="{x:Bind ViewModel.Autostart, Mode=TwoWay}" />
            </toolkit:SettingsCard>
            <toolkit:SettingsExpander
                Description="Через OpenRGB. Меняются только отмеченные устройства"
                Header="Клавиатура и другой RGB"
                ItemsSource="{x:Bind ViewModel.OpenRgbDevices, Mode=OneTime}">
                <toolkit:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE765;" />
                </toolkit:SettingsExpander.HeaderIcon>
                <ToggleSwitch IsOn="{x:Bind ViewModel.OpenRgbEnabled, Mode=TwoWay}" />
                <toolkit:SettingsExpander.ItemsHeader>
                    <TextBlock
                        Margin="58,10,16,10"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind ViewModel.OpenRgbNote, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </toolkit:SettingsExpander.ItemsHeader>
                <toolkit:SettingsExpander.ItemTemplate>
                    <DataTemplate x:DataType="vm:OpenRgbDevice">
                        <toolkit:SettingsCard Header="{x:Bind Name, Mode=OneTime}">
                            <ToggleSwitch IsOn="{x:Bind IsOn, Mode=TwoWay}" />
                        </toolkit:SettingsCard>
                    </DataTemplate>
                </toolkit:SettingsExpander.ItemTemplate>
            </toolkit:SettingsExpander>
            <toolkit:SettingsCard Description="Лента погаснет, значок в трее исчезнет" Header="Выключить Halo">
                <Button Command="{x:Bind ViewModel.QuitServiceCommand}" Content="Выключить" />
            </toolkit:SettingsCard>

            <TextBlock
                Margin="1,20,0,0"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="Ctrl + Shift + Alt и стрелки ↑ ↓ меняют яркость, ← → переключают режим, F10 включает и выключает подсветку."
                TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
